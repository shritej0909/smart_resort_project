{
  "name": "smart-resort-360",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node --watch --env-file=.env server/index.mjs",
    "client": "node scripts/vite.mjs",
    "build": "tsc --noEmit && node scripts/vite.mjs --build",
    "preview": "vite preview",
    "start": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "nugen:align": "node scripts/nugen_align.mjs",
    "nugen:test": "node scripts/test_nugen.mjs",
    "setup": "node scripts/setup.mjs"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@supabase/supabase-js": "^2.45.0",
    "@types/leaflet": "^1.9.22",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.22.3",
    "framer-motion": "^13.4.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.294.0",
    "pdf-parse": "^1.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-leaflet": "^4.2.1",
    "recharts": "^2.10.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/ws": "^8.5.10",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.8"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
