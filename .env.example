# ============================================================
# Smart Resort 360 — Environment Variables Template
# Copy this file to .env and fill in your values
# ============================================================

# --- Nugen Intelligence (HackCelestial 3.0 Task 2) ---
# Replace PASTE_NUGEN_API_KEY_HERE with your real Nugen API key from https://nugen.in
NUGEN_API_KEY=PASTE_NUGEN_API_KEY_HERE
NUGEN_MODEL_ID=hospitality-aligned-qwen-0p5b
NUGEN_BASE_URL=https://api.nugen.in

# --- Google Gemini ---
# Get your key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# --- Supabase (Optional) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# --- App ---
PORT=5000
NODE_ENV=development

# --- Production Passwords ---
GUEST_PASSWORD=
MANAGER_PASSWORD=
